// Syslog receiver - for appliances that can't run an agent (UniFi UDM,
// switches, Proxmox via rsyslog forwarding, TrueNAS itself). Point their
// remote-logging config at whichever host's Alloy you want receiving this
// - normally just the full-stack host.
//
// This file's NAME is load-bearing, not just descriptive: docker-compose.yml
// mounts ./config/alloy/${COMPOSE_PROFILES:-empty}.alloy as this component's
// source, reusing the same COMPOSE_PROFILES value already used to gate
// loki/grafana rather than adding a second, separate toggle var. So this
// file must be named exactly "full.alloy" to match COMPOSE_PROFILES=full on
// the full-stack host - renaming it breaks the mount. See docker-compose.yml
// and empty.alloy for the agent-only-host counterpart.
//
// forward_to references loki.write.default, declared in base.alloy - both
// files load together via Alloy's directory-loading mode (alloy run on a
// directory merges every *.alloy file inside it into one configuration).
//
// Two listeners, not one, because "syslog" isn't one wire format - learned
// this the hard way against the SMHub (BusyBox syslogd): it only emits
// legacy RFC3164, which a default (RFC5424) listener rejects outright
// ("expecting a version value in the range 1-999" - the parser reading
// BusyBox's timestamp text where RFC5424 expects a version integer). Each
// device needs pointing at whichever port matches what it *actually* sends,
// confirmed per-device (check Alloy's own logs for parse warnings after
// pointing a new source here) rather than assumed from the vendor. RFC5424
// (the current IETF standard) gets the default syslog port; the legacy
// format gets the non-default one, deliberately - not the other way round:
//   - 514/udp  rfc5424 - NOT YET CONFIRMED against any real device. Proxmox
//     can be pointed at either (real rsyslog - set `template =
//     "RSYSLOG_SyslogProtocol23Format"` on the omfwd forwarding action for
//     5424; omit it and it's 3164-style like everything else below). UniFi
//     UDM/switches and TrueNAS's own remote-syslog setting have no documented
//     format choice - verify empirically before assuming either defaults
//     here rather than to 1514.
//   - 1514/udp rfc3164 - confirmed: SMHub (BusyBox syslogd has no format
//     option at all - see smhub-stability-investigation.md). SMHub's own
//     /etc/conf.d/syslogd -R target must point at 1514, not 514.
loki.relabel "syslog_labels" {
  forward_to = []

  // Pulled from the message content itself (both RFC3164 and RFC5424 carry
  // a hostname field) - not hardcoded per-listener, since both ports will
  // end up receiving more than one device once UniFi/Proxmox/TrueNAS are
  // added. __-prefixed internal labels are dropped unless relabeled like
  // this (standard Prometheus/Loki convention).
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }

  // Fallback/cross-check for any sender that leaves the hostname field
  // empty or wrong - the connection source IP is always present regardless
  // of what the device puts in the message body.
  rule {
    source_labels = ["__syslog_connection_ip_address"]
    target_label  = "source_ip"
  }

  // Deliberately NOT promoting facility/severity/app_name to labels -
  // query those from the log line via LogQL instead. Turning every
  // distinct value into a label is how Loki installations end up with
  // runaway stream cardinality as more device types get added here.
}

loki.source.syslog "network_devices" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "rfc5424"
  }

  listener {
    address                          = "0.0.0.0:1514"
    protocol                         = "udp"
    syslog_format                    = "rfc3164"
    rfc3164_default_to_current_year  = true // RFC3164 timestamps carry no year
  }

  relabel_rules = loki.relabel.syslog_labels.rules
  forward_to    = [loki.write.default.receiver]
}
