// Same config on every host, full-stack or agent-only alike - only
// LOKI_PUSH_URL (set in .env) differs between them. Confirmed syntax for
// every component below against Grafana's own current docs while writing
// this (discovery.docker, loki.source.docker, loki.relabel, loki.write) -
// component names/arguments change between Alloy releases often enough
// that this is worth re-checking rather than assuming, if this file is
// touched again after a version bump.
//
// Loaded via Alloy's directory-loading mode alongside whichever of
// full.alloy/empty.alloy COMPOSE_PROFILES selects (see docker-compose.yml
// and full.alloy) - this file alone has no syslog receiver; that's
// entirely in full.alloy now, kept out of every agent-only host by
// default.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Docker's container name comes through as a discovery label
// (__meta_docker_container_name, with a leading "/") - promoted to a real
// "container" label so Grafana can actually filter by it. Used purely as
// a rule-provider here (forward_to left empty) - entries flow through
// loki.source.docker below, not through this component directly.
//
// The job/stack rules below promote two Docker container labels
// (logging_jobname, stackname) that already exist on every container in
// the docker-truenas stacks (home-assistant-stack, traefik-portainer,
// vscode, hello-world) via their own x-common-labels anchor - previously
// inert since no Loki/Alloy existed to read them. discovery.docker
// exposes a container's own Docker labels as
// __meta_docker_container_label_<name> (confirmed against Alloy's docs).
// Containers that don't carry these labels (this stack's own
// loki/grafana/alloy containers, anything not using that anchor) just
// don't get a job/stack label - an empty relabel result drops the label
// rather than setting it to "", standard Prometheus-style relabel
// behavior.
loki.relabel "docker" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_logging_jobname"]
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_label_stackname"]
    target_label  = "stack"
  }
}

loki.source.docker "default" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  forward_to    = [loki.write.default.receiver]
  relabel_rules = loki.relabel.docker.rules
}

loki.write "default" {
  endpoint {
    # sys.env(), not the bare env() stdlib function - confirmed live
    # (docker-green test run) that env() is deprecated as of this
    # Alloy version, logged as a startup warning even though the
    # component still evaluated fine. sys.env() is the documented
    # replacement; unrelated to the LOKI_PUSH_URL value itself, which is
    # passed straight into the container's own environment (not sourced
    # from a shell profile), so the usual systemd/profile-inheritance
    # gotchas with sys.env() don't apply here.
    url = sys.env("LOKI_PUSH_URL")
  }
}
