# Copy to .env and fill in real values - .env is gitignored.

# Dataset paths - all optional. Each falls back to ./data/<service> (relative
# to this file, gitignored) if left unset, so a plain `cp .env.example .env`
# with zero edits works for a quick local test - e.g. on docker-green, no
# real dataset needed. For an actual TrueNAS/production deployment, set
# these to real ZFS dataset paths instead, so Loki's chunks/index get
# snapshots/reliability for free. On an agent-only host, only
# ALLOY_DATA_PATH matters - LOKI_DATA_PATH/GRAFANA_DATA_PATH are unused
# there (loki/grafana need the "full" profile active to start at all).
#LOKI_DATA_PATH=/mnt/nvme_pool1/Apps/grafana/loki
#GRAFANA_DATA_PATH=/mnt/nvme_pool1/Apps/grafana/grafana
#ALLOY_DATA_PATH=/mnt/nvme_pool1/Apps/grafana/alloy

# Where this host's Alloy instance pushes logs to.
#   Full-stack host (this repo's own Loki, same compose network):
#     http://loki:3100/loki/api/v1/push
#   Agent-only host (pushing to a remote Loki elsewhere):
#     http://<loki-host>.lan.example.internal:3100/loki/api/v1/push
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

GRAFANA_ADMIN_PASSWORD=changeme
# Leave blank unless Grafana is reachable through a different external URL
# than http://<host>:3000 (e.g. behind a reverse proxy later).
GRAFANA_ROOT_URL=

# Only needed if you apply the optional docker-compose.traefik.yml overlay
# (see README) - exposes Grafana via the shared Traefik instance instead of
# a direct LAN port. Not needed for the default LAN-only deployment.
GRAFANA_HOST=grafana.example.internal
NETWORK=traefik
MONITORING_STACK=grafana-stack
