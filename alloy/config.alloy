// Same config on every host, full-stack or agent-only alike - only
// LOKI_PUSH_URL (set in .env) differs between them. Confirmed syntax for
// every component below against Grafana's own current docs while writing
// this (discovery.docker, loki.source.docker, loki.relabel,
// loki.source.syslog, loki.write) - component names/arguments change
// between Alloy releases often enough that this is worth re-checking
// rather than assuming, if this file is touched again after a version bump.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Docker's container name comes through as a discovery label
// (__meta_docker_container_name, with a leading "/") - promoted to a real
// "container" label so Grafana can actually filter by it. Used purely as
// a rule-provider here (forward_to left empty) - entries flow through
// loki.source.docker below, not through this component directly.
loki.relabel "docker" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "default" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  forward_to    = [loki.write.default.receiver]
  relabel_rules = loki.relabel.docker.rules
}

// Syslog receiver - for appliances that can't run an agent (UniFi UDM,
// switches, Proxmox via rsyslog forwarding, TrueNAS itself). Point their
// remote-logging config at whichever host's Alloy you want receiving this
// - normally just the full-stack host. An idle, unused listener on any
// other host this config runs on.
loki.source.syslog "network_devices" {
  listener {
    address  = "0.0.0.0:514"
    protocol = "udp"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}
